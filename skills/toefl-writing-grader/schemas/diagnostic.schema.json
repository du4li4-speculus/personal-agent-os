{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agent-os.local/schemas/toefl/diagnostic.schema.json",
  "title": "TOEFL Writing diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagnosis_id", "student", "assessment_id", "ability_layers", "issues", "evidence", "priority", "confidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "diagnosis_id": {"type": "string", "minLength": 1},
    "student": {"type": "string", "minLength": 1},
    "assessment_id": {"type": "string", "minLength": 1},
    "ability_layers": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["task_response", "organization", "language_control", "reasoning"]}
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "ability_layer", "statement", "evidence_ids", "priority"],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "ability_layer": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "priority": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "priority": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "teacher_override_ids": {"type": "array", "items": {"type": "string"}}
  }
}
