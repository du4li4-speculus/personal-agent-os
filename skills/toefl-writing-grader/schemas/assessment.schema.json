{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agent-os.local/schemas/toefl/assessment.schema.json",
  "title": "TOEFL Writing assessment configuration",
  "description": "A synchronization contract for existing TOEFL scoring logic; it does not define new score rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "evidence_id", "pieces"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "assessment_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "student": {"type": "string", "minLength": 1},
    "pieces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/piece"}},
    "score_inputs": {"type": "object", "additionalProperties": true},
    "quant_inputs": {"type": "object", "additionalProperties": true},
    "ability_charts": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  },
  "$defs": {
    "piece": {
      "type": "object",
      "additionalProperties": false,
      "required": ["piece_id", "task_type", "scores", "evidence_ids"],
      "properties": {
        "piece_id": {"type": "string", "minLength": 1},
        "task_type": {"enum": ["email", "academic_discussion"]},
        "scores": {
          "type": "object",
          "minProperties": 6,
          "additionalProperties": {"type": "number", "minimum": 2, "maximum": 5}
        },
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "original_text": {"type": ["string", "null"]},
        "diagnostic_notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
