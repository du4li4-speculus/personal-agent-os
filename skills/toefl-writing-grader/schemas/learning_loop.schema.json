{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agent-os.local/schemas/toefl/learning_loop.schema.json",
  "title": "TOEFL Writing learning loop",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagnosis_id", "priority", "actions", "validation_plan"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "diagnosis_id": {"type": "string", "minLength": 1},
    "priority": {"type": "string", "minLength": 1},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "teacher_override_ids": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "ability_layer", "task", "success_signal"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "ability_layer": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "success_signal": {"type": "string", "minLength": 1},
        "time_limit_minutes": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
