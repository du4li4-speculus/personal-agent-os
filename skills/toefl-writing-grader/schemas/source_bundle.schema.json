{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agent-os.local/schemas/toefl/source_bundle.schema.json",
  "title": "TOEFL Writing source bundle",
  "description": "The provenance-preserving input contract shared by every source adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "sequence", "role", "kind", "format", "filename",
        "mime_type", "sha256", "byte_size", "content", "extraction"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "role": {"enum": ["prompt", "response", "annotation", "unknown"]},
        "kind": {"enum": ["text", "image", "document", "pages"]},
        "format": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "uri": {"type": ["string", "null"]},
        "mime_type": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_size": {"type": "integer", "minimum": 0},
        "received_at": {"type": "string", "format": "date-time"},
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "blocks", "images"],
          "properties": {
            "text": {"type": ["string", "null"]},
            "blocks": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
            "images": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
            "annotations": {"type": "object", "additionalProperties": true}
          }
        },
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "method", "status", "warnings"],
          "properties": {
            "adapter": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1},
            "status": {"enum": ["complete", "partial", "pending", "pending_ocr", "failed", "unknown"]},
            "warnings": {"type": "array", "items": {"type": "string"}},
            "encoding": {"type": ["string", "null"]},
            "document_iwa_checked_at_start": {"type": "boolean"},
            "package_members": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
