{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agent-os.local/schemas/toefl/evidence.schema.json",
  "title": "TOEFL Writing evidence",
  "description": "Traceable evidence extracted from source_bundle.json; it contains no assessment score.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "bundle_id", "items", "gaps", "summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "minLength": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_count", "evidence_count", "prompt_available", "response_available", "assessment_ready"],
      "properties": {
        "source_count": {"type": "integer", "minimum": 0},
        "evidence_count": {"type": "integer", "minimum": 0},
        "prompt_available": {"type": "boolean"},
        "response_available": {"type": "boolean"},
        "assessment_ready": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_id", "type", "role", "text", "locator", "provenance"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["prompt_text", "response_text", "unclassified_text", "annotation", "image_reference"]},
        "role": {"type": "string", "minLength": 1},
        "text": {"type": ["string", "null"]},
        "locator": {"type": "object", "additionalProperties": true},
        "attributes": {"type": "object", "additionalProperties": true},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "method", "confidence"],
          "properties": {
            "adapter": {"type": ["string", "null"]},
            "method": {"type": ["string", "null"]},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "requires": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "code", "reason", "status"],
      "properties": {
        "source_id": {"type": ["string", "null"]},
        "code": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"}
      }
    }
  }
}
