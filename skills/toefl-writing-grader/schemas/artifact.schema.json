{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agent-os.local/schemas/toefl/artifact.schema.json",
  "title": "TOEFL Writing artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "source", "validation_required"],
  "properties": {
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["student_report", "parent_report", "teacher_dashboard"]}
    },
    "source": {"type": "string", "const": "assessment.json"},
    "evidence_source": {"type": "string", "const": "evidence.json"},
    "validation_required": {"const": true},
    "format": {"enum": ["glass_pdf", "json", "markdown"]},
    "student_page_requirements": {"type": "array", "items": {"type": "string"}},
    "parent_page_count": {"type": "integer", "const": 1}
  }
}
